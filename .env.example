# ==============================================================================
# Job Hunter & ATS Tailor Agent — Environment Variables Example
# Copia este archivo a `.env` (raíz para pipeline) y/o a `apps/web/.env.local`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Pipeline de Extracción e Inferencia IA (services/pipeline)
# ------------------------------------------------------------------------------

# Google Gemini API Key (obtén una gratis en https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=tu_clave_gemini_aqui

# Supabase Project URL (ej. https://abcdefghijklmnopqrst.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase Service Role Key (clave secreta del backend con permisos de escritura / bypass RLS)
# OBTENER EN: Supabase Dashboard > Project Settings > API > Project API keys > service_role (secret)
# ¡NUNCA exponer en el frontend ni subir a Git!
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# ------------------------------------------------------------------------------
# 2. Frontend Web Next.js (apps/web)
# Configurar en `apps/web/.env.local` o en Vercel Environment Variables
# ------------------------------------------------------------------------------

# Supabase Project URL (público para cliente navegador y Next.js SSR)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase Anon Public Key (clave pública para cliente navegador y Next.js SSR protegida por RLS)
# OBTENER EN: Supabase Dashboard > Project Settings > API > Project API keys > anon (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
